# Environment Configuration for Production Docker Deployment
# Copy this file to .env and update with your actual values

# ==============================================
# Database Configuration
# ==============================================
# PostgreSQL password for the messaging_user
# Generate with: openssl rand -base64 32
DB_PASSWORD=changeme123

# Optional: Database connection pool size (default: 20)
POOL_SIZE=20

# ==============================================
# Application Secrets
# ==============================================
# Secret key base for signing/encrypting cookies and tokens
# Generate with: openssl rand -base64 64
# Or with Elixir: mix phx.gen.secret
SECRET_KEY_BASE=your_secret_key_base_here_generate_with_openssl_rand_base64_64

# ==============================================
# Domain Configuration
# ==============================================
# Your application domain (used for URL generation)
# Use localhost for local testing, or your actual domain for production
DOMAIN=localhost

# ==============================================
# Storage Configuration (MinIO S3)
# ==============================================
# MinIO admin credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ==============================================
# Redis Configuration
# ==============================================
# Redis password (if using authentication)
REDIS_PASSWORD=redispass123

# ==============================================
# Optional: Custom Features Configuration
# ==============================================
# Path to custom features.yaml file
# If not set, uses default config/features.yaml
# FEATURES_CONFIG_PATH=./config/features.production.yaml

# ==============================================
# Optional: Local Storage Configuration
# ==============================================
# If not using S3/MinIO, configure local storage
# LOCAL_STORAGE_URL=http://localhost:4000/storage
